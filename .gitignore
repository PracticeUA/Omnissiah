## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider
.idea/

# VS Code
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET
*.dll
*.exe
*.pdb
*.cache
*.dbmdl

# ASP.NET / IIS
*.publishsettings

# NuGet
*.nupkg
.nuget/
packages/
!packages/build/
*.snupkg

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Visual Studio cache
.vs/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
*.sln.iml

# Xamarin / Mono
*.userprefs

# WPF specific
*.g.cs
*.g.i.cs
*.baml
*.cache
*.generated.cs

# Publish
publish/

# Logs
*.log

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# OS generated
.DS_Store

# Backup files
*.bak
*.backup
*.tmp
*.temp

# SQL local db
*.mdf
*.ldf

# Entity Framework
*.edmx.diagram

# NUnit
*.VisualState.xml
TestResult.xml

# Coverage
coverage/
*.coverage
*.coveragexml

# DotMemory
*.dmw

# StyleCop
StyleCopReport.xml

# Local settings
appsettings.Development.json

# Secrets
secrets.json

# Generated files
Generated_Code/

# ClickOnce
publish.htm

# Installer files
*.msi
*.msix
*.appx
*.appxbundle

# Azure
csx/
*.build.csdef

# Paket
.paket/
paket-files/

# FAKE
.fake/

